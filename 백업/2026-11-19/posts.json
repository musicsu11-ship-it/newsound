[{"id":"fb632475-5991-4b42-912d-f6aa3d9992b1","board":"news","title":"새소리단, 댓글로 응원받았습니다! 💚","body":"“새소리단 4행시”부터\n새소리단 활동을 향한 응원의 한마디까지!\n\n많은 분들이 보내주신 따뜻한 마음 덕분에\n새소리단의 활동에 힘이 더해졌습니다. 🐣\n\n앞으로도 듣고, 소통하고, 변화로 이어가는 새소리단이 되겠습니다!","images":[{"name": "IMG_9027.jpg", "path": "posts/b1f61e2c-4beb-419f-a0b1-3f504bbea46d/1788357483683-ksw8r5.jpg"}],"pinned":false,"author_id":"b1f61e2c-4beb-419f-a0b1-3f504bbea46d","author_name":"오미연","created_at":"2026-09-02T13:58:04.888815+00:00","author_team":"","author_dept":"","team_no":null,"collab_need":null,"collab_status":"open","topic":null,"likes":3,"due_at":null,"place":null}, 
 {"id":"5ce1fd67-b95b-4411-882b-9c112409e419","board":"news","title":"새소리단 부산 워크숍을 다녀왔습니다!","body":"부산에서 5. 28.(목)~5. 29.(금) 1박 2일동안 제8기 새내기 소통 리더단 워크숍을 진행했습니다.\n\n팀별 프로젝트 진행상황 공유 및 새소리단 운영방식에 대해서 토론하고 향후 계획을 구체화하였습니다.","images":[{"name": "워크숍.jpg", "path": "posts/78093755-0280-41ec-9f1d-4d50733abb5a/1788355022887-01yekr.jpg"}],"pinned":false,"author_id":"78093755-0280-41ec-9f1d-4d50733abb5a","author_name":"이승연","created_at":"2026-09-02T13:17:04.192194+00:00","author_team":"","author_dept":"","team_no":null,"collab_need":null,"collab_status":"open","topic":null,"likes":2,"due_at":null,"place":null}, 
 {"id":"4ba59171-b252-4fd3-b182-cd049eba8325","board":"news","title":"제8기 새소리단 발대식 현장입니다","body":"4월 17일, 본부 대회의실에서 제8기 새내기 소통 리더단 발대식이 있었습니다.\n\n그간 추진 경과를 살펴보고, 총 여섯 개의 팀을 나누어 올해 활동 방향 등 소개하였습니다.","images":[{"name": "발대식.jpg", "path": "posts/78093755-0280-41ec-9f1d-4d50733abb5a/1788355656390-6srtkp.jpg"}],"pinned":false,"author_id":"78093755-0280-41ec-9f1d-4d50733abb5a","author_name":"이승연","created_at":"2026-09-02T13:27:37.205342+00:00","author_team":"","author_dept":"","team_no":null,"collab_need":null,"collab_status":"open","topic":null,"likes":2,"due_at":null,"place":null}, 
